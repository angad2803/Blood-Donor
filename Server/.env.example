# ========================================
# 🩸 BLOOD DONATION APP - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to Server/.env and fill in your actual values

# ========================================
# 📊 DATABASE CONFIGURATION
# ========================================
# MongoDB connection string (use MongoDB Atlas in production)
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/mydb?retryWrites=true&w=majority
# Alternate name (some deployments expect this)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/mydb?retryWrites=true&w=majority

# ========================================
# 🔐 AUTHENTICATION & SECURITY
# ========================================
# JWT Secret for token signing (CHANGE THIS TO A STRONG SECRET!)
JWT_SECRET=replace_with_secure_random_string

# ========================================
# 🌐 SERVER CONFIGURATION
# ========================================
# Port for the backend server (Render provides this automatically)
PORT=5000
# Node environment
NODE_ENV=production

# ========================================
# 📧 EMAIL CONFIGURATION
# ========================================
# Email (SMTP) settings for Nodemailer
ENABLE_WELCOME_EMAILS=true
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=you@example.com
EMAIL_PASS=your_email_app_password
SUPPORT_EMAIL=support@yourdomain.com

# ========================================
# 🗄️ REDIS CONFIGURATION (For Bull Queues)
# ========================================
# Redis connection for message queues (Upstash or managed Redis)
REDIS_URL=redis://:<password>@hostname:6379
REDIS_HOST=hostname
REDIS_PORT=6379

# ========================================
# 🔧 LOGGING & DEBUG
# ========================================
DEBUG=false
LOG_LEVEL=info

# ========================================
# 🚀 DEPLOYMENT (Production only)
# ========================================
# Frontend origin(s) for CORS and OAuth redirect. Use the production frontend URL.
CLIENT_URL=https://your-frontend.vercel.app
# Optionally support multiple origins (comma-separated)
# CLIENT_URLS=https://your-frontend.vercel.app,https://admin.yourdomain.com

# ========================================
# 📍 EXTERNAL SERVICES
# ========================================
# ArcGIS API (if using ArcGIS geolocation features)
ARCGIS_API_KEY=your_arcgis_api_key

# ========================================
# 🧠 AI PROVIDER CONFIG
# ========================================
# Which provider to use: openai or gemini
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# ========================================
# 🔑 GOOGLE OAUTH
# ========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ========================================
# NOTES
# - Keep secrets out of version control. Use Render's Environment Dashboard to set these values.
# - After deployment, set CLIENT_URL to the frontend URL from Vercel.
