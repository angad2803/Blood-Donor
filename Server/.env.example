# ========================================
# 🩸 BLOOD DONATION APP - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to Server/.env and fill in your actual values

# ========================================
# 📊 DATABASE CONFIGURATION
# ========================================
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/blood_donor
# Alternative MongoDB URI variable name (some setups use this)
MONGODB_URI=mongodb://localhost:27017/blood_donor

# ========================================
# 🔐 AUTHENTICATION & SECURITY
# ========================================
# JWT Secret for token signing (CHANGE THIS TO A STRONG SECRET!)
JWT_SECRET=your-super-secret-jwt-key-replace-this-with-a-strong-random-string

# ========================================
# 🌐 SERVER CONFIGURATION
# ========================================
# Port for the backend server
PORT=5000
# Node environment
NODE_ENV=development

# ========================================
# 📧 EMAIL CONFIGURATION (Optional)
# ========================================
# Email service for notifications (if you add email features)
# RESEND_API_KEY=your-resend-api-key
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# FROM_EMAIL=onboarding@resend.dev

# ========================================
# 🗄️ REDIS CONFIGURATION (For Bull Queues)
# ========================================
# Redis connection for message queues
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ========================================
# 🔧 DEVELOPMENT TOOLS (Optional)
# ========================================
# Debug mode
DEBUG=false
# Log level
LOG_LEVEL=info

# ========================================
# 🚀 DEPLOYMENT (Production only)
# ========================================
# Client URL for CORS (update for production)
CLIENT_URL=http://localhost:5173
# Server URL
SERVER_URL=http://localhost:5000

# ========================================
# 📍 EXTERNAL SERVICES (Optional)
# ========================================
# Google Maps API (if you add maps features)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# ArcGIS API (if using ArcGIS)
# ARCGIS_API_KEY=your-arcgis-api-key
